const express = require('express');
const path = require('path');
const app = express();

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const usersDB = {};
const ADMIN_EMAIL = "Josetntlyric@gmail.com";

app.post('/api/login', (req, res) => {
    const { email, password } = req.body;
    if (!email || !password) {
        return res.status(400).json({ error: 'Ingresa correo y contraseña.' });
    }
    let userId = email.toLowerCase().trim();
    if (!usersDB[userId]) {
        const initialCredits = (email === ADMIN_EMAIL) ? 99999 : 3;
        usersDB[userId] = { email, password, credits: initialCredits };
    } else {
        if (usersDB[userId].password !== password) {
            return res.status(401).json({ error: 'Contraseña incorrecta.' });
        }
    }
    if (email === ADMIN_EMAIL) {
        usersDB[userId].credits = 99999;
    }
    res.json({ 
        success: true, 
        uid: userId, 
        email: usersDB[userId].email, 
        credits: usersDB[userId].credits,
        isAdmin: (email === ADMIN_EMAIL)
    });
});

app.post('/api/paypal-success', (req, res) => {
    const { uid, orderId } = req.body;
    if (!uid || !usersDB[uid]) {
        return res.status(400).json({ error: 'Usuario no válido' });
    }
    usersDB[uid].credits += 50; 
    console.log(`[JClip AI] ¡Pago exitoso recibido! Correo destino: josetntlyric@gmail.com | Orden: ${orderId}`);
    res.json({ success: true, newCredits: usersDB[uid].credits });
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`🚀 JClip AI corriendo en http://localhost:${PORT}`);
});
